<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes DiagnosticLogger's log file to the share sheet via FileProvider (see the
     <provider> entry in AndroidManifest.xml). Both paths are declared since
     DiagnosticLogger falls back to internal storage if external storage is unavailable. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="external_files" path="." />
    <files-path name="internal_files" path="." />
</paths>
